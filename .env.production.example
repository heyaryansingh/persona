# Required public hostname and ACME contact for automatic TLS.
DOMAIN=persona.aryansingh.org
ACME_EMAIL=you@example.com

# Generate with: openssl rand -base64 36
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required by the application. Do not commit this file after filling it in.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PERSONA_ENCRYPTION_KEY=
PERSONA_SESSION_SECRET=
PERSONA_PUBLIC_MODE=1
PERSONA_ALLOWED_ORIGINS=https://persona.aryansingh.org
PERSONA_PUBLIC_DAILY_CAP_USD=5
PERSONA_PUBLIC_MAX_PERSONAS=1

# Optional source/API credentials.
NCBI_API_KEY=
OPENALEX_API_KEY=
CONTACT_EMAIL=you@example.com
